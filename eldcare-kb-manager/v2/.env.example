# 应用配置（所有变量必须以 ELDCARE_ 前缀才会被 Pydantic 读取）

# 服务端口
ELDCARE_PORT=8090

# 节点角色：master（主控，pi05 默认）/ slave（前台，本机默认）
ELDCARE_NODE_ROLE=master

# 数据目录（绝对路径或相对路径）
ELDCARE_DATA_DIR=./data

# 媒体目录（V2 默认扫描这里；master 节点指向 /mnt/ztv/movies）
ELDCARE_MOVIES_DIR=./data/movies

# 主备同步
ELDCARE_PEER_URL=
ELDCARE_PEER_TOKEN=

# TMDB 元数据
ELDCARE_TMDB_API_KEY=
ELDCARE_TMDB_LANG=zh-CN

# aria2 下载引擎
ELDCARE_ARIA2_RPC_URL=http://127.0.0.1:6800/jsonrpc
ELDCARE_ARIA2_SECRET=

# 日志
ELDCARE_LOG_LEVEL=INFO
ELDCARE_LOG_DIR=./data/logs

# 鉴权
ELDCARE_JWT_SECRET=change-me-in-production
ELDCARE_JWT_TTL_HOURS=720
